config_version=4

[application]
config/name="钢铁余烬 · Switch"
config/description="Iron Embers native 3D Switch 1 homebrew edition"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="IronEmbersSwitch"

[display]
window/size/width=1280
window/size/height=720
window/stretch/mode="2d"
window/stretch/aspect="keep"

[rendering]
quality/driver/driver_name="GLES2"
quality/directional_shadow/size=2048
quality/shadow_atlas/size=1024
quality/filters/msaa=1
vram_compression/import_etc=true
environment/default_clear_color=Color(0.09,0.14,0.18,1)

[physics]
common/physics_fps=60
