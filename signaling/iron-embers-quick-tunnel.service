[Unit]
Description=Temporary public WSS tunnel for Iron Embers room tests
After=network-online.target iron-embers-signaling.service
Wants=network-online.target
Requires=iron-embers-signaling.service

[Service]
Type=simple
ExecStart=/home/zcx/opt/cloudflared tunnel --no-autoupdate --protocol http2 --url http://127.0.0.1:8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
